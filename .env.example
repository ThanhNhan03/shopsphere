# Local demonstration credentials only; replace before sharing a deployment.
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=shopsphere-local
RABBITMQ_USER=shopsphere
RABBITMQ_PASSWORD=shopsphere-local
POSTGRES_PORT=6543
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
GATEWAY_PORT=8080
FRONTEND_PORT=3000
SEQ_UI_PORT=8081
SEQ_INGEST_PORT=5341
FRONTEND_URL=http://localhost:3000
# Demo simulates success/failure without charging a card. Stripe uses signed webhooks.
PAYMENT_MODE=Demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Google OAuth web client. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gateway quotas per 60 seconds. Reads/writes per account; login starts per connection IP.
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_LOGIN=10

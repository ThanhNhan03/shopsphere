# Local demonstration credentials only; replace before sharing a deployment.
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=shopsphere-local
RABBITMQ_USER=shopsphere
RABBITMQ_PASSWORD=shopsphere-local
RABBITMQ_INTERNAL_PORT=5672
RABBITMQ_USE_SSL=false
POSTGRES_PORT=6543
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
GATEWAY_PORT=8080
FRONTEND_PORT=3000
SEQ_UI_PORT=8081
SEQ_INGEST_PORT=5341
FRONTEND_URL=http://localhost:3000
# Demo simulates success/failure without charging a card. Stripe uses signed webhooks.
PAYMENT_MODE=Demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Google OAuth web client. Callback: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gateway quotas per 60 seconds. Reads/writes per account; login starts per connection IP.
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_LOGIN=10
# Optional verified Google accounts allowed to manage the store (comma separated).
ADMIN_EMAILS=
# A local admin is seeded once when a strong bootstrap password is provided.
ADMIN_BOOTSTRAP_EMAIL=admin@shopsphere.local
ADMIN_BOOTSTRAP_PASSWORD=
MINIO_ROOT_USER=shopsphere
MINIO_ROOT_PASSWORD=shopsphere-minio-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=shopsphere-products
# Customer email defaults to log-only simulation. Set SMTP credentials to deliver mail.
EMAIL_MODE=Console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ShopSphere
